# Database — SQLite for local/dev (default schema provider)
DATABASE_URL="file:./dev.db"

# For production Postgres: change prisma/schema.prisma datasource provider to
# "postgresql" and set e.g.:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/skinfolio?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# OpenAI (optional — chat degrades gracefully without it)
OPENAI_API_KEY=

# Optional object storage later (journal photos currently use local uploads/)
# BLOB_READ_WRITE_TOKEN=
# S3_BUCKET=
